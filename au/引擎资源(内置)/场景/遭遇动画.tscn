[sub_resource type="GDScript" id="GDScript_xh1l1"]
resource_name = "跳转"
script/source = "extends AnimationPlayer
## ============================================================
##  动画播放完毕 → 跳转场景
## ============================================================
##  用法：
##    1. 把脚本挂到 AnimationPlayer 节点上
##    2. 在检查器里填写「目标场景路径」和「要监听的动画名」
##    3. 动画播完就会自动跳转
## ============================================================

@export_group(\"跳转设置\")
## 要跳转到的场景路径，比如 \"res://场景/主菜单.tscn\"
@export_file(\"*.tscn\") var 目标场景路径: String = \"\"
## 要监听的动画名（留空 = 监听所有动画）
@export var 监听的动画名: String = \"\"
## 播放结束后多久再跳（秒），0 = 立刻跳
@export var 延迟秒数: float = 0.0


func _ready() -> void:
	# 连接\"动画播放结束\"信号
	animation_finished.connect(_动画播放完毕)


func _动画播放完毕(动画名: StringName) -> void:
	# 如果指定了监听某个动画，但播的不是它 → 忽略
	if 监听的动画名 != \"\" and String(动画名) != 监听的动画名:
		return

	# 检查场景路径是否有效
	if 目标场景路径 == \"\" or not ResourceLoader.exists(目标场景路径):
		return

	# 需要延迟就延迟，不需要就立刻跳
	if 延迟秒数 > 0.0:
		await get_tree().create_timer(延迟秒数).timeout

	get_tree().change_scene_to_file(目标场景路径)
"

