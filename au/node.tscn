[sub_resource type="GDScript" id="GDScript_1pwje"]
resource_name = "主角框"
script/source = "extends Node2D
## ============================================================
##  主角系统 · 纯脚本版（曲线绘制，无着色器）
## ------------------------------------------------------------
##  改动说明：
##  1. 主角不再自己读取键盘输入，移动完全由「其他角色/系统」
##     调用指令接口来驱动（命令角色移动 / 命令角色移动一步 / 命令角色停止）
##  2. 主角不再被方框「拖着走」。方框移动时主角原地不动；
##     只有主角被方框边缘挤到时，才会被推回框内（表现为跟着框走），
##     而这时主角依然可以自己移动（因为指令接口仍然生效）。
##  3. 主角在框内部、没碰到边缘时，方框怎么动都不会影响它。
## ============================================================

@export_group(\"角色设置\")
@export var 角色贴图: Texture2D
@export var 角色移动速度: float = 200.0
@export var 角色初始偏移: Vector2 = Vector2.ZERO

@export_group(\"方框设置 · 单位 = 像素格\")
@export var 方框尺寸: Vector2i = Vector2i(138, 46)
@export_range(1, 64, 1) var 边框厚度: int = 2
@export_range(0, 64, 1) var 圆角半径: int = 4
@export_range(1.0, 32.0, 0.5) var 像素格大小: float = 4.0
@export var 居中显示: bool = true
@export_range(24, 256, 8) var 轮廓精度: int = 128

@export_group(\"方框形状\")
@export_enum(\"矩形\", \"圆形\") var 形状类型: int = 0
@export var 圆形半径: float = -1.0
@export var 变形时间: float = 0.5

var 方框实例: 方框 = null
var 角色实例: 角色 = null


func _ready() -> void:
	方框实例 = 方框.new()
	方框实例.方框尺寸 = 方框尺寸
	方框实例.边框厚度 = 边框厚度
	方框实例.圆角半径 = 圆角半径
	方框实例.像素格大小 = 像素格大小
	方框实例.居中显示 = 居中显示
	方框实例.圆形半径 = 圆形半径
	方框实例.轮廓精度 = 轮廓精度
	方框实例._形状混合 = 1.0 if 形状类型 == 1 else 0.0
	add_child(方框实例)

	角色实例 = 角色.new()
	角色实例.texture = 角色贴图
	角色实例.移动速度 = 角色移动速度
	角色实例.所属方框 = 方框实例
	角色实例.position = 方框实例.获取本地中心() + 角色初始偏移
	add_child(角色实例)

	# 告诉方框「角色有多大」，这样才能画出角色中心的可活动区域
	if 角色贴图 != null:
		方框实例.调试内缩 = 角色实例.获取碰撞半尺寸()


# ============================================================
#  对外指令接口（给「其他角色 / 系统」调用）
# ============================================================

## 让主角朝某方向持续移动。
## 方向长度会被限制在 1 以内（Vector2.ZERO 表示停下）。
## 调用一次后就会一直生效，直到再次调用或调用 命令角色停止()。
func 命令角色移动(方向: Vector2) -> void:
	if 角色实例 != null:
		角色实例.命令移动(方向)


## 让主角立刻停下
func 命令角色停止() -> void:
	if 角色实例 != null:
		角色实例.停止移动()


## 让主角朝某方向位移一段距离（一次性，不受速度/帧率影响）
func 命令角色移动一步(方向: Vector2, 距离: float) -> void:
	if 角色实例 != null:
		角色实例.命令移动一步(方向, 距离)


# ============================================================
#  方框变形 / 移动控制
# ============================================================

func 变形为圆形(时间: float = -1.0) -> void:
	if 方框实例 != null:
		方框实例.变形为(方框.形状.圆形, 时间 if 时间 >= 0 else 变形时间)

func 变形为矩形(时间: float = -1.0) -> void:
	if 方框实例 != null:
		方框实例.变形为(方框.形状.矩形, 时间 if 时间 >= 0 else 变形时间)

func 移动(x: float, y: float, 时间: float = 1.0) -> void:
	if 方框实例 == null: return
	var tween := create_tween()
	tween.set_trans(Tween.TRANS_SINE).set_ease(Tween.EASE_IN_OUT)
	tween.tween_property(方框实例, \"position\", Vector2(x, y), 时间)

func 瞬移(x: float, y: float) -> void:
	if 方框实例 != null:
		方框实例.position = Vector2(x, y)


# ============================================================
#  内部类：方框（等弧长采样 + 逐段填充）
# ============================================================
class 方框 extends Node2D:
	enum 形状 { 矩形, 圆形 }

	var 方框尺寸: Vector2i = Vector2i(138, 46)
	var 边框厚度: int = 2
	var 圆角半径: int = 4
	var 像素格大小: float = 4.0
	var 居中显示: bool = true
	var 圆形半径: float = -1.0
	var 轮廓精度: int = 128

	var _形状混合: float = 0.0:
		set(v):
			_形状混合 = v
			queue_redraw()

	## 角色碰撞半尺寸：用来画出「角色中心能走到的范围」
	var 调试内缩: Vector2 = Vector2.ZERO:
		set(v):
			调试内缩 = v
			queue_redraw()


	func _ready() -> void:
		queue_redraw()


	func 变形为(目标形状: 形状, 时间: float) -> void:
		var 目标值: float = 1.0 if 目标形状 == 形状.圆形 else 0.0
		if is_equal_approx(_形状混合, 目标值):
			return
		var tween := create_tween()
		tween.set_trans(Tween.TRANS_SINE).set_ease(Tween.EASE_IN_OUT)
		tween.tween_property(self, \"_形状混合\", 目标值, 时间)


	# ==================== 绘制 ====================

	func _draw() -> void:
		var N := maxi(轮廓精度, 24)

		var 外点 := _采样轮廓(N, true)
		var 有内轮廓 := _内半().x > 0.0 and _内半().y > 0.0

		if not 有内轮廓:
			draw_colored_polygon(外点, Color.WHITE)
			return

		var 内点 := _采样轮廓(N, false)

		for i in N:
			var i2 := (i + 1) % N
			var 四边形 := PackedVector2Array([
				外点[i],
				外点[i2],
				内点[i2],
				内点[i],
			])
			draw_colored_polygon(四边形, Color.WHITE)


	static func _闭合(点: PackedVector2Array) -> PackedVector2Array:
		var 结果 := 点.duplicate()
		if 结果.size() > 0:
			结果.append(结果[0])
		return 结果


	## 沿轮廓等弧长采样 N 个点
	## 内缩：把整个轮廓向内推 内缩 距离（用于画角色可活动区）
	func _采样轮廓(N: int, 外: bool, 内缩: Vector2 = Vector2.ZERO) -> PackedVector2Array:
		var 点 := PackedVector2Array()
		点.resize(N)

		var 半 := (_外半() if 外 else _内半()) - 内缩
		半 = Vector2(maxf(半.x, 0.0), maxf(半.y, 0.0))

		var r := (_外圆角() if 外 else _内圆角()) - maxf(内缩.x, 内缩.y)
		r = maxf(r, 0.0)

		var 椭圆轴 := (_外椭圆轴() if 外 else _内椭圆轴()) - 内缩
		椭圆轴 = Vector2(maxf(椭圆轴.x, 0.0), maxf(椭圆轴.y, 0.0))

		var 混合 := _形状混合

		for i in N:
			var t := float(i) / float(N)
			var 矩形点 := _圆角矩形轮廓点(t, 半, r)
			var 椭圆点 := _椭圆轮廓点(t, 椭圆轴)
			点[i] = 矩形点.lerp(椭圆点, 混合)

		return 点


	## 圆角矩形轮廓上参数 t 处的点（等弧长参数化）
	## t = 0 在上边中点，顺时针绕一圈
	func _圆角矩形轮廓点(t: float, 半: Vector2, r: float) -> Vector2:
		r = minf(r, minf(半.x, 半.y))
		var 直线横 := maxf(半.x - r, 0.0)
		var 直线纵 := maxf(2.0 * 半.y - 2.0 * r, 0.0)
		var 弧长 := PI * r * 0.5
		var 总长 := 4.0 * 直线横 + 2.0 * 直线纵 + 4.0 * 弧长

		if 总长 < 0.0001:
			return Vector2(0.0, -半.y)

		var p := fposmod(t, 1.0) * 总长

		# 1. 上边右半段
		if p < 直线横:
			return Vector2(p, -半.y)
		p -= 直线横

		# 2. 右上弧
		if p < 弧长:
			var a := -PI * 0.5 + (p / 弧长) * PI * 0.5
			return Vector2(半.x - r + cos(a) * r, -半.y + r + sin(a) * r)
		p -= 弧长

		# 3. 右边
		if p < 直线纵:
			return Vector2(半.x, -半.y + r + p)
		p -= 直线纵

		# 4. 右下弧
		if p < 弧长:
			var a := (p / 弧长) * PI * 0.5
			return Vector2(半.x - r + cos(a) * r, 半.y - r + sin(a) * r)
		p -= 弧长

		# 5. 下边右半段
		if p < 直线横:
			return Vector2(半.x - r - p, 半.y)
		p -= 直线横

		# 6. 下边左半段
		if p < 直线横:
			return Vector2(-p, 半.y)
		p -= 直线横

		# 7. 左下弧
		if p < 弧长:
			var a := PI * 0.5 + (p / 弧长) * PI * 0.5
			return Vector2(-半.x + r + cos(a) * r, 半.y - r + sin(a) * r)
		p -= 弧长

		# 8. 左边
		if p < 直线纵:
			return Vector2(-半.x, 半.y - r - p)
		p -= 直线纵

		# 9. 左上弧
		if p < 弧长:
			var a := PI + (p / 弧长) * PI * 0.5
			return Vector2(-半.x + r + cos(a) * r, -半.y + r + sin(a) * r)
		p -= 弧长

		# 10. 上边左半段
		return Vector2(-半.x + r + p, -半.y)


	## 椭圆轮廓上参数 t 处的点（t = 0 在顶部，顺时针）
	func _椭圆轮廓点(t: float, 轴: Vector2) -> Vector2:
		var θ := -PI * 0.5 + fposmod(t, 1.0) * TAU
		return Vector2(cos(θ) * 轴.x, sin(θ) * 轴.y)


	# ==================== 几何辅助 ====================

	func _外半() -> Vector2:
		return Vector2(方框尺寸) * 像素格大小 * 0.5

	func _内半() -> Vector2:
		var 边 = float(边框厚度) * 像素格大小
		return _外半() - Vector2(边, 边)

	func _外椭圆轴() -> Vector2:
		if 圆形半径 < 0.0:
			return _外半()
		else:
			var r: float = 圆形半径 * 像素格大小
			return Vector2(r, r)

	func _内椭圆轴() -> Vector2:
		var 边 = float(边框厚度) * 像素格大小
		var 外轴 := _外椭圆轴()
		return Vector2(maxf(外轴.x - 边, 0.1), maxf(外轴.y - 边, 0.1))

	func _外圆角() -> float:
		return minf(float(圆角半径) * 像素格大小, minf(_外半().x, _外半().y))

	func _内圆角() -> float:
		return maxf(_外圆角() - float(边框厚度) * 像素格大小, 0.0)


	# ==================== SDF（给角色碰撞用） ====================

	static func _椭圆距离(p: Vector2, ab: Vector2) -> float:
		var k1 := (p / ab).length()
		if k1 < 0.000001:
			return -minf(ab.x, ab.y)
		var k2 := (p / (ab * ab)).length()
		return k1 * (k1 - 1.0) / k2

	func _混合SDF(p: Vector2, 外: bool) -> float:
		var 矩形SDF: float
		var 椭圆SDF: float

		if 外:
			矩形SDF = _圆角矩形距离(p, _外半(), _外圆角())
			椭圆SDF = _椭圆距离(p, _外椭圆轴())
		else:
			var 半 := _内半()
			if 半.x <= 0.0 or 半.y <= 0.0:
				return 999999.0
			矩形SDF = _圆角矩形距离(p, 半, _内圆角())
			椭圆SDF = _椭圆距离(p, _内椭圆轴())

		return lerpf(矩形SDF, 椭圆SDF, _形状混合)


	func 本地点在形状内(本地点: Vector2, 内缩: Vector2 = Vector2.ZERO) -> bool:
		var sdf := _混合SDF(本地点, false)
		var 内缩量: float = maxf(内缩.x, 内缩.y)
		return sdf <= -内缩量

	func 本地推回形状内(本地点: Vector2, 内缩: Vector2 = Vector2.ZERO) -> Vector2:
		var 内缩量: float = maxf(内缩.x, 内缩.y)
		for i in 20:
			var sdf := _混合SDF(本地点, false)
			if sdf <= -内缩量:
				return 本地点
			var eps := 0.5
			var dx := _混合SDF(本地点 + Vector2(eps, 0), false) - sdf
			var dy := _混合SDF(本地点 + Vector2(0, eps), false) - sdf
			var 梯度 := Vector2(dx, dy)
			if 梯度.length() < 0.0001:
				本地点 *= 0.5
			else:
				梯度 = 梯度.normalized()
				本地点 -= 梯度 * (sdf + 内缩量)
		return 本地点

	func 点在形状内(世界点: Vector2, 内缩: Vector2 = Vector2.ZERO) -> bool:
		var 中心世界 := to_global(获取本地中心())
		return 本地点在形状内(世界点 - 中心世界, 内缩)

	func 推回形状内(世界点: Vector2, 内缩: Vector2 = Vector2.ZERO) -> Vector2:
		var 中心世界 := to_global(获取本地中心())
		var 新本地 := 本地推回形状内(世界点 - 中心世界, 内缩)
		return 中心世界 + 新本地


	# ==================== 中心/边界 ====================

	func 获取本地中心() -> Vector2:
		if 居中显示:
			return Vector2.ZERO
		else:
			return Vector2(方框尺寸) * 像素格大小 * 0.5

	func 获取边界矩形() -> Rect2:
		var 局部尺寸 := Vector2(方框尺寸) * 像素格大小
		var 局部左上 := Vector2.ZERO
		if 居中显示:
			局部左上 = -局部尺寸 * 0.5
		var 全局左上 := to_global(局部左上)
		var 全局右下 := to_global(局部左上 + 局部尺寸)
		return Rect2(全局左上, 全局右下 - 全局左上)

	func 获取内边界矩形() -> Rect2:
		var 外尺寸 := Vector2(方框尺寸) * 像素格大小
		var 边框像素 := float(边框厚度) * 像素格大小
		var 内尺寸 := 外尺寸 - Vector2(边框像素, 边框像素) * 2.0
		var 局部左上 := Vector2(边框像素, 边框像素)
		if 居中显示:
			局部左上 = -内尺寸 * 0.5
		var 全局左上 := to_global(局部左上)
		var 全局右下 := to_global(局部左上 + 内尺寸)
		return Rect2(全局左上, 全局右下 - 全局左上)


	# ==================== 工具 ====================

	static func _圆角矩形距离(p: Vector2, half: Vector2, r: float) -> float:
		var q := Vector2(absf(p.x) - half.x + r, absf(p.y) - half.y + r)
		var outside := Vector2(maxf(q.x, 0.0), maxf(q.y, 0.0)).length()
		var inside := minf(maxf(q.x, q.y), 0.0)
		return outside + inside - r


# ============================================================
#  内部类：角色
# ============================================================
class 角色 extends Sprite2D:
	var 移动速度: float = 200.0
	var 所属方框: Node2D = null

	## 外部指令方向。只由 命令移动()/停止移动() 改写，
	## 角色自己不会去读键盘。
	var _指令方向: Vector2 = Vector2.ZERO


	# ========================================================
	#  指令接口（其他角色 / 系统调用）
	# ========================================================

	## 设置持续移动方向。长度会被限制在 1 以内，Vector2.ZERO 表示停下。
	func 命令移动(方向: Vector2) -> void:
		_指令方向 = 方向.limit_length(1.0)
		if _指令方向.length() < 0.001:
			_指令方向 = Vector2.ZERO


	## 立刻停下
	func 停止移动() -> void:
		_指令方向 = Vector2.ZERO


	## 一次性位移（不受帧率影响）
	func 命令移动一步(方向: Vector2, 距离: float) -> void:
		if 方向.length() < 0.001 or is_zero_approx(距离):
			return
		_尝试移动(方向.normalized() * 距离)


	# ========================================================
	#  每帧更新
	# ========================================================
	func _process(delta: float) -> void:
		# 先处理「被方框挤出」——只有碰到边缘 / 被框扫到时才会动
		_被方框边缘挤压时跟随()

		# 再处理自己（由指令驱动）的移动
		if _指令方向 != Vector2.ZERO:
			_尝试移动(_指令方向 * 移动速度 * delta)


	## 方框移动时：主角不主动跟随。
	## 只有当主角被方框边缘「压到」时（即已经跑到形状外 / 碰到边界），
	## 才把它推回形状内 —— 表现上就是被框推着走。
	## 主角在框内部且没碰边时，这里什么都不做。
	func _被方框边缘挤压时跟随() -> void:
		if 所属方框 == null:
			return
		if not 所属方框.has_method(\"本地点在形状内\"):
			return
		if 全局变量.当前回合 == 0:
			return

		var 半尺寸 := Vector2.ZERO
		if texture != null:
			半尺寸 = texture.get_size() * 0.5 * scale

		var 中心世界: Vector2 = 所属方框.to_global(所属方框.获取本地中心())
		var 本地点: Vector2 = global_position - 中心世界

		# 还在可活动区域内 → 不管方框怎么动，主角都不动
		if 所属方框.本地点在形状内(本地点, 半尺寸):
			return

		# 越界了 → 推回最近的合法位置（被框挤着走）
		var 新本地点: Vector2 = 所属方框.本地推回形状内(本地点, 半尺寸)
		global_position = 中心世界 + 新本地点


	## 角色碰撞盒在本地坐标系里的真实矩形
	## 用 CanvasItem.get_rect()：它会自动把 centered / offset / scale 全算进去，
	## 不像原来那样默认「贴图一定居中」，所以框不会和角色错位。
	func 获取碰撞矩形() -> Rect2:
		if texture == null:
			return Rect2(Vector2(-8, -8), Vector2(16, 16))
		return get_rect()


	## 角色碰撞半尺寸（与 _位置合法 保持一致）
	func 获取碰撞半尺寸() -> Vector2:
		if texture == null:
			return Vector2.ZERO
		return 获取碰撞矩形().size * 0.5


	# ========================================================
	#  移动：直接走 → 分轴走 → 圆形切线滑动
	# ========================================================
	func _尝试移动(位移: Vector2) -> void:
		if 全局变量.当前回合 == 0 or 所属方框 == null:
			global_position += 位移
			return

		# ① 直接走
		var 新位置 := global_position + 位移
		if _位置合法(新位置):
			global_position = 新位置
			return

		# ② 分轴走
		var 动过 := false
		if 位移.x != 0.0:
			var 新X := global_position + Vector2(位移.x, 0)
			if _位置合法(新X):
				global_position.x = 新X.x
				动过 = true
		if 位移.y != 0.0:
			var 新Y := global_position + Vector2(0, 位移.y)
			if _位置合法(新Y):
				global_position.y = 新Y.y
				动过 = true
		if 动过:
			return

		# ③ 只有圆形形态才做切线滑动
		if _所属方框是圆形():
			_尝试沿边滑动(位移)


	func _所属方框是圆形() -> bool:
		if 所属方框 == null:
			return false
		if not \"_形状混合\" in 所属方框:
			return false
		return 所属方框._形状混合 > 0.5


	func _尝试沿边滑动(位移: Vector2) -> void:
		if 位移.length() < 0.001:
			return

		var 中心世界: Vector2 = 所属方框.to_global(所属方框.获取本地中心())
		var 本地位置: Vector2 = global_position - 中心世界

		if 本地位置.length() < 0.001:
			return

		var 半径方向 := 本地位置.normalized()
		var 切线方向 := Vector2(-半径方向.y, 半径方向.x)

		var 投影: float = 位移.dot(切线方向)
		if absf(投影) < 0.001:
			切线方向 = -切线方向
			投影 = 位移.dot(切线方向)
			if absf(投影) < 0.001:
				return

		var 滑动位移 := 切线方向 * 投影

		var 新位置 := global_position + 滑动位移
		if _位置合法(新位置):
			global_position = 新位置
			return

		var 向心 := -半径方向 * 0.5
		var 贴合位置 := global_position + 滑动位移 + 向心
		if _位置合法(贴合位置):
			global_position = 贴合位置


	func _位置合法(测试位置: Vector2) -> bool:
		if 所属方框 == null or not 所属方框.has_method(\"本地点在形状内\"):
			return true
		var 半尺寸 := Vector2.ZERO
		if texture != null:
			半尺寸 = texture.get_size() * 0.5 * scale
		var 中心世界: Vector2 = 所属方框.to_global(所属方框.获取本地中心())
		var 本地点: Vector2 = 测试位置 - 中心世界
		return 所属方框.本地点在形状内(本地点, 半尺寸)
"

[sub_resource type="GDScript" id="GDScript_o5d88"]
resource_name = "显示"

[sub_resource type="GDScript" id="GDScript_ubxb5"]
script/source = "extends Node
## ============================================================
##  主角键盘控制器
## ------------------------------------------------------------
##  这个脚本只做一件事：
##    读 WASD / 方向键  →  翻译成 命令  →  发给主角脚本
##
##  主角脚本（那个 方框+角色 的系统）自己已经支持：
##    命令角色移动(方向)      持续移动
##    命令角色移动一步(方向,距离)  一次性位移
##    命令角色停止()          立刻停下
##  所以这里不需要、也不应该去碰主角的 position。
##
##  用法：
##    1. 把这个脚本挂到场景里任意 Node 上
##    2. 把「主角节点」拖到检查器的 主角 槽位
##    3. 运行，按 WASD / 方向键
## ============================================================

@export_group(\"连接\")
## 挂着你那个「主角系统」脚本的节点
@export var 主角节点: Node = null

@export_group(\"操作方式\")
## 开：持续按住移动（平台跳跃手感）
## 关：每按一次走一步（回合制 / 地牢手感）
@export var 持续移动: bool = true

## 「一步」模式下每次走的距离（像素）
@export var 单步距离: float = 64.0

## 「一步」模式下两次位移之间至少间隔多久（秒），防止连发过快
@export_range(0.01, 1.0, 0.01) var 单步冷却: float = 0.15

@export_group(\"调试\")
## 勾上会在输出面板打印每次发出的命令
@export var 打印命令: bool = false

var _上次单步时间: float = 0.0

## 每个方向最近一次按下的时间（秒）。
## 同一轴的上下 / 左右互斥时，谁按得晚就听谁的：
## 先按右再按左，松开右之前一直是左。
var _按下时间: Dictionary = {}


func _ready() -> void:
	# 清空记录
	for 动作 in [\"left\", \"right\", \"up\", \"down\"]:
		_按下时间[动作] = -1.0

	if 主角节点 == null:
		push_warning(\"主角控制器：没有设置「主角节点」，控制器不会工作。\")
		return
	# 检查接口对不对，早报错比晚崩好
	for 方法 in [\"命令角色移动\", \"命令角色移动一步\", \"命令角色停止\"]:
		if not 主角节点.has_method(方法):
			push_error(\"主角控制器：主角节点缺少方法「%s」，请确认挂的是那个主角系统脚本。\" % 方法)
			return


func _process(_delta: float) -> void:
	if 主角节点 == null:
		return

	var 方向 := 读取方向()

	if 持续移动:
		# 持续模式：有方向就一直走，没方向就停
		if 方向 == Vector2.ZERO:
			主角节点.命令角色停止()
		else:
			主角节点.命令角色移动(方向)
	else:
		# 单步模式：只在有方向时走一步，冷却防止连发
		if 方向 != Vector2.ZERO and _冷却好了():
			_上次单步时间 = Time.get_ticks_msec() / 1000.0
			主角节点.命令角色移动一步(方向, 单步距离)
			if 打印命令:
				print(\"单步移动：\", 方向)


## 读取键盘方向
## 规则：同一轴的上下互斥、左右互斥，取「最近按下」的那个。
## 不同轴可以同时生效，所以能走出左上 / 右下 这类斜向。
func 读取方向() -> Vector2:
	var 方向 := Vector2.ZERO

	# 左右轴：取最近按下的那一个
	if Input.is_action_pressed(\"left\") and Input.is_action_pressed(\"right\"):
		方向.x = -1.0 if _按下时间[\"left\"] > _按下时间[\"right\"] else 1.0
	elif Input.is_action_pressed(\"left\"):
		方向.x = -1.0
	elif Input.is_action_pressed(\"right\"):
		方向.x = 1.0

	# 上下轴：取最近按下的那一个
	if Input.is_action_pressed(\"up\") and Input.is_action_pressed(\"down\"):
		方向.y = -1.0 if _按下时间[\"up\"] > _按下时间[\"down\"] else 1.0
	elif Input.is_action_pressed(\"up\"):
		方向.y = -1.0
	elif Input.is_action_pressed(\"down\"):
		方向.y = 1.0

	# 归一化：斜向移动不会比直线快 √2 倍
	return 方向.normalized() if 方向 != Vector2.ZERO else Vector2.ZERO


## 记录方向键按下的先后顺序
func _input(event: InputEvent) -> void:
	if not (event is InputEventKey):
		return
	var 键 := event as InputEventKey
	if not 键.pressed or 键.echo:
		return

	var 动作 := \"\"
	match 键.keycode:
		KEY_LEFT, KEY_A:
			动作 = \"left\"
		KEY_RIGHT, KEY_D:
			动作 = \"right\"
		KEY_UP, KEY_W:
			动作 = \"up\"
		KEY_DOWN, KEY_S:
			动作 = \"down\"

	if 动作 != \"\":
		_按下时间[动作] = Time.get_ticks_msec() / 1000.0


func _冷却好了() -> bool:
	var 现在 := Time.get_ticks_msec() / 1000.0
	return 现在 - _上次单步时间 >= 单步冷却
"

